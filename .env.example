# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SERVER ONLY. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# AI Grading Provider (server only). OpenAI-compatible API (Kilo AI Gateway by default).
# Leave AI_API_KEY empty to grade manually.
AI_API_KEY=
AI_BASE_URL=https://ai-gateway.kilo.ai/api/v1
AI_MODEL=kilo-auto/free
# Development only: deterministic fake grader when the key above is empty.
AI_MOCK=0

# Cron grading endpoint (server only). Protects /api/cron/grading (Bearer token).
CRON_SECRET=

# Optional hard rate limits (falls back to in-memory when unset).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Seed script only (npm run seed)
SEED_ADMIN_PASSWORD=
SEED_STUDENT_PASSWORD=Student123!
# Required as 1 only when deliberately seeding a production project.
SEED_ALLOW_PROD=

# Cloudflare Turnstile (CAPTCHA) - optional in dev, required in production
# Get keys from https://dash.cloudflare.com/ -> Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Absolute URL for OTP/resend redirects (used by signup and resend-otp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
